# vCentral configuration. Copy to .env (scripts/install.sh does this and fills in the secrets).
# Keep this file private: chmod 600 .env

# --- Secrets (generated by scripts/install.sh) ---------------------------------------------------
# Random string, at least 32 characters. Signs login sessions; changing it signs everyone out.
VCENTRAL_SECRET_KEY=
# Database password. Use letters and digits only (it is embedded in a connection URL).
POSTGRES_PASSWORD=

# --- vCenter ---------------------------------------------------------------------------------------
VCENTRAL_VCENTER_HOST=vcenter.example.local
VCENTRAL_VCENTER_PORT=443
# A dedicated service account. Phase 1 only needs the built-in "Read-only" role on the vCenter root.
VCENTRAL_VCENTER_USER=svc-vcentral@vsphere.local
VCENTRAL_VCENTER_PASSWORD=
# Set to false only if vCenter uses a self-signed certificate you cannot replace.
VCENTRAL_VCENTER_VERIFY_SSL=true
# Optional: SSO account allowed to manage vCenter's own services (Infrastructure page). Defaults to the account above.
# VCENTRAL_APPLIANCE_USER=administrator@vsphere.local
# VCENTRAL_APPLIANCE_PASSWORD=
# If your VMs have a vCenter custom attribute that holds the owner, put its name here.
VCENTRAL_OWNER_ATTRIBUTE=Owner
# Shared vCenter accounts that are never suggested as a VM's owner on the Owners page (comma-separated).
VCENTRAL_OWNER_IGNORE_USERS=administrator@vsphere.local

# Sign-up on the login page (new accounts are always read-only Viewers). Admins can change both on Settings.
VCENTRAL_SIGNUP_ENABLED=true
VCENTRAL_SIGNUP_REQUIRES_APPROVAL=true

# Browser SSH/RDP through guacd (installed by deploy/native/install.sh). Set false to turn it off.
VCENTRAL_REMOTE_ACCESS_ENABLED=true

# --- Network view ----------------------------------------------------------------------------------
# Comma-separated subnets to show on the "IP & subnets" page, e.g. 10.10.20.0/24,10.10.21.0/24
VCENTRAL_SUBNETS=

# --- First admin account ---------------------------------------------------------------------------
VCENTRAL_ADMIN_USERNAME=admin
# Temporary password; you must change it at first sign-in. Leave empty to get a random one in the logs.
VCENTRAL_ADMIN_PASSWORD=

# --- Address of vCentral ----------------------------------------------------------------------------
# How the admin team and VMs reach vCentral, e.g. https://vcentral.example.local (links in messages, agent installs).
VCENTRAL_PUBLIC_URL=

# --- Notifications to the admin team (email + Google Chat) ----------------------------------------
# vCentral is for the admin team only: nothing is sent to VM owners or other end users.
VCENTRAL_SMTP_HOST=
VCENTRAL_SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
VCENTRAL_SMTP_SECURITY=starttls
VCENTRAL_SMTP_USER=
VCENTRAL_SMTP_PASSWORD=
VCENTRAL_SMTP_FROM=
# Google Chat: Space > Apps & integrations > Webhooks > Add webhook, paste the URL here.
VCENTRAL_GOOGLE_CHAT_WEBHOOK=
# Comma-separated admin team addresses (onboarding digest; alerts in a later release).
VCENTRAL_ADMIN_EMAILS=

# --- Agents ----------------------------------------------------------------------------------------
# Agents pin the HTTPS certificate's fingerprint, so a self-signed certificate is safe.
# If you install a certificate from your own CA (trusted by the VMs), you may set this to false; with
# pinning on, agents must be reinstalled whenever the certificate is replaced.
VCENTRAL_AGENT_PIN_CERTIFICATE=true
# Starting values only: admins change intervals on the Settings page, without a restart.
VCENTRAL_AGENT_REPORT_INTERVAL_SECONDS=20
VCENTRAL_AGENT_INVENTORY_INTERVAL_SECONDS=3600

# --- Tuning (defaults are fine for ~300 VMs) -----------------------------------------------------------
VCENTRAL_SYNC_INTERVAL_SECONDS=30
VCENTRAL_METRICS_RAW_RETENTION_DAYS=7
VCENTRAL_METRICS_HOURLY_RETENTION_DAYS=180
VCENTRAL_HISTORY_RETENTION_DAYS=365
VCENTRAL_SESSION_HOURS=8
